# Rust build output is generated and must not be committed.
/target/

# Python script caches are generated and must not be committed.
__pycache__/
*.py[cod]

# Runtime SQLite sidecars are not canonical source data.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# The hosted mirror is generated from the canonical tracked SQLite database.
# Keep its disposable JSON/assets build input out of the project history.
/public-mirror/public/data/catalog.json
/public-mirror/public/assets/modules/
/public-mirror/public/assets/placeholders/
