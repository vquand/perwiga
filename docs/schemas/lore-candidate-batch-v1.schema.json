{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perwiga.local/schemas/lore-candidate-batch-v1.schema.json",
  "title": "Perwiga lore candidate batch",
  "description": "Offline, source-backed lore candidates awaiting human review. The schema stores claims and relationships, not alternate-universe branches.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module_id", "corpus", "generator", "sources", "periods", "subjects", "events"],
  "properties": {
    "schema": {"const": "perwiga-lore-candidates/v1"},
    "module_id": {"type": "string", "minLength": 1},
    "corpus": {"$ref": "#/$defs/corpus"},
    "generator": {"$ref": "#/$defs/generator"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "periods": {"type": "array", "items": {"$ref": "#/$defs/period"}},
    "subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "minLength": 1}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "generated_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "provider", "identity", "title", "language", "content_sha256", "checked_at"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "content_sha256": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "locator", "excerpt"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1},
        "stance": {"enum": ["supports", "contradicts"]}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name_en", "order"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name_en": {"type": "string", "minLength": 1},
        "description_en": {"type": ["string", "null"]},
        "order": {"type": "integer"},
        "parent_key": {"type": ["string", "null"]}
      }
    },
    "subject-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "identity"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "attested_name", "proposed_type", "evidence"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "attested_name": {"type": "string", "minLength": 1},
        "proposed_type": {"type": "string", "minLength": 1},
        "entity_ref": {"$ref": "#/$defs/subject-reference"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "precision", "label", "relations"],
      "properties": {
        "kind": {"enum": ["moment", "interval"]},
        "precision": {"enum": ["exact", "bounded", "approximate", "relative", "unknown"]},
        "label": {"type": "string", "minLength": 1},
        "start_period_key": {"type": ["string", "null"]},
        "end_period_key": {"type": ["string", "null"]},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/event-relation"}}
      }
    },
    "event-relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event_key"],
      "properties": {
        "kind": {"enum": ["before", "after", "overlaps", "contains"]},
        "event_key": {"type": "string", "minLength": 1}
      }
    },
    "involvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_key", "role"],
      "properties": {
        "subject_key": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text_en", "assertion_kind", "certainty", "involvements", "evidence"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "text_en": {"type": "string", "minLength": 1},
        "assertion_kind": {"enum": ["direct_fact", "in_world_report", "hearsay", "inference", "interpretation"]},
        "certainty": {"enum": ["confirmed", "probable", "possible", "disputed", "unknown"]},
        "branch_group": {"type": ["string", "null"]},
        "involvements": {"type": "array", "items": {"$ref": "#/$defs/involvement"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title_en", "time", "involvements", "claims"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "title_en": {"type": "string", "minLength": 1},
        "summary_en": {"type": ["string", "null"]},
        "time": {"$ref": "#/$defs/time"},
        "involvements": {"type": "array", "items": {"$ref": "#/$defs/involvement"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    }
  }
}
